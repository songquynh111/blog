<form class="mt-4" name="container-form" method="post" action="/courses/hanlde-form-action">
    <h3>My Courses</h3>
    <h3>Đã xóa: {{countDocumentsDeleted}}</h3>
    <div class="mt-4 d-flex align-item-center">

      <select class="form-select form-select-sm select-all" name="action" aria-label="Default select example" required>
        <option value="">chọn</option>
        <option value="delete">Xóa</option>
        <option value="3">Three</option>
      </select>
      <button class="btn btn-primary btn-submit" disabled>
        Áp dụng
      </button>
    </div>
    <table class="table">
        <thead>
            <tr>
            <th scope="col" >
              <div class="form-check">
                <input class="form-check-input" type="checkbox" value="" id="checkbox-all">
                <label class="form-check-label" for="checkbox-all">
                  Select all
                </label>
              </div>
            </th>
            <th scope="col" >ID
              {{{ sortable '_id' _sort }}}
            </th>
            <th scope="col">Tên
              {{{ sortable 'name' _sort }}}
            </th>
            <th scope="col">Mô tả
              {{{ sortable 'description' _sort }}}
            </th>
            <th scope="col">Slug
              {{{ sortable 'slug' _sort }}}
            </th>
            <th scope="col" >Thời gian xóa
              {{{ sortable 'deletedAt' _sort }}}
            </th>
            <th scope="col">Action</th>
            </tr>
        </thead>
        <tbody>
            {{#each courses}}
            <tr>
                <td>
                  <div class="form-check">
                    <input class="form-check-input" type="checkbox" value="{{ this._id }}" name="courseIds[]">
                  </div>
                </td>
                {{!-- <th scope="row">{{sum @index 1}}</th> --}}
                <th scope="row">{{ this._id }}</th>
                <td>{{ this.name }}</td>
                <td>{{ this.description }}</td>
                <td>{{ this.slug }}</td>
                <td>{{ this.deletedAt }}</td>
                <td>
                    <a href="/courses/{{ this._id }}/edit" class="btn btn-link">Sửa</a>
                    <a href="" class="btn btn-link" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#deleteModal" data-id="{{ this._id }}">Xóa mềm</a>
                    <a href="" class="btn btn-link btn-force-delete" class="btn btn-primary" data-id="{{ this._id }}">Xóa hẳn</a>
                    <a href="" class="btn btn-link btn-restore" class="btn btn-primary" data-id="{{ this._id }}">Restore</a>
                </td>
            </tr>
            {{else}}
              <tr>
                <td colspan="5" class="text-center">
                  Nothing
                  <a href="/course/create">Thêm mới</a>
                </td>
              </tr>
            {{/each }}
        </tbody>
    </table>
</form>

<div class="modal fade" id="deleteModal" tabindex="-1" aria-labelledby="deleteModalLabel" aria-hidden="true">
  <div class="modal-dialog">
    <div class="modal-content">
      <div class="modal-header">
        <h1 class="modal-title fs-5" id="deleteModalLabel">Are u sủe?</h1>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body">
        Chắc chắn chưa?
      </div>
      <div class="modal-footer">
        <button type="button" id="btnDelete" href="" class="btn btn-danger">Delete</button>
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
      </div>
    </div>
  </div>
</div>

<form name="deleteForm" method="post"></form>
<form name="restoreForm" method="post"></form>
<form name="forceDeleteForm" method="post"></form>

<script>
  document.addEventListener("DOMContentLoaded", function () {
    const deleteModal = document.getElementById('deleteModal')
    var courseId;
    var deleteForm = document.forms['deleteForm']
    var restoreForm = document.forms['restoreForm']
    var forceDeleteForm = document.forms['forceDeleteForm']
    //var containerForm = document.forms['container-form']
    var containerForm = $('form[name="container-form"]')
    var btnDelete = document.getElementById('btnDelete')
    var btnRestore = $('.btn-restore')
    var btnForceDelete = $('.btn-force-delete')
    var checkboxAll = $('#checkbox-all')
    var itemCheckboxCourse = $('input[name="courseIds[]"]')
    var checkAllSubmitBtn = $('.btn-submit');

    if (deleteModal) {
        deleteModal.addEventListener('show.bs.modal', event => {
            const button = event.relatedTarget
            courseId = button.getAttribute('data-id')
            console.log(document.forms);
        })
    }
    btnDelete.onclick = function() {
        deleteForm.action = '/courses/' + courseId + '?_method=DELETE';
        deleteForm.submit()
    }

    btnRestore.on( "click", function(e) {
      e.preventDefault();
      const id = $(this).data('id');
      restoreForm.action = '/courses/' + id + '/restore?_method=PATCH';
      restoreForm.submit()
    } );

    btnForceDelete.on( "click", function(e) {
      e.preventDefault();
      const id = $(this).data('id');
      forceDeleteForm.action = '/courses/' + id + '/force?_method=DELETE';
      forceDeleteForm.submit()
    })

    // handle checkall
    checkboxAll.on( "change", function(e) {
      var ischeckedAll = $(this).prop('checked')
      itemCheckboxCourse.prop('checked',ischeckedAll)
      renderCheckAllSubmitBtn()
    })

    // handle check item
    itemCheckboxCourse.on( "change", function(e) {
      var ischeckedAll = itemCheckboxCourse.length === $('input[name="courseIds[]"]:checked').length
      checkboxAll.prop('checked', ischeckedAll)
      renderCheckAllSubmitBtn()
    })

    {{!-- checkAllSubmitBtn.on( "click", function(e) {
      e.preventDefault()
      var isSubmit = !$(this).hasClass('disabled')
      if(isSubmit){
        //  submit bằng js, cái này khác với hành vi submit mặc định của trình duyệt nên các thuộc tính như required của 
        // select hay input ko nhận
        containerForm.submit()
      }
    })  --}}

    //submit mặc định của trình duyệt
    {{!-- containerForm.on( "submit", function(e) {
      var isSubmit = !checkAllSubmitBtn.hasClass('disabled')
      if(!isSubmit){
        e.preventDefault()
      }
    }) --}}

    
    function renderCheckAllSubmitBtn() {
      var checkedCnt = $('input[name="courseIds[]"]:checked').length
      if(checkedCnt) {
        checkAllSubmitBtn.removeAttr('disabled')
      }else {
        checkAllSubmitBtn.attr('disabled', true)
      }
    }
  });
</script>