<div class="mt-4">
    <h3>Sửa khóa học</h3>
    <div class="row">
        <form method="post" action="/courses/{{ course._id }}?_method=PUT">
            <div class="mb-3">
                <label for="exampleInputEmail1" class="form-label">Name</label>
                <input type="text" name="name" class="form-control" value="{{ course.name }}">
            </div>
            <div class="mb-3">
                <label for="exampleInputPassword1" class="form-label">Description</label>
                <textarea type="text" name="description" class="form-control" value="">{{ course.description }}</textarea>
            </div>
            <div class="mb-3">
                <label for="exampleInputPassword1" class="form-label">Video id</label>
                <input type="text" name="videoId" class="form-control" value="{{ course.videoId }}">
            </div>
            <button type="submit" class="btn btn-primary">Save</button>
        </form>
    </div>
</div>